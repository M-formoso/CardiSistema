# Ignora todo lo que no necesita el build de Railpack (backend o frontend).
# Reduce el contexto que BuildKit sube al daemon.

# Dependencias y build output locales
node_modules
**/node_modules
dist
**/dist
.turbo
**/.turbo
coverage
**/coverage

# Git y tooling
.git
.gitignore
.github
.vscode
.idea
.claude
.cursor
.DS_Store

# Documentación y material del cliente (pesado, solo para desarrollo)
docs
migracion
inicial.md
README.md
CLAUDE.md
*.md
!packages/**/*.md
!backend/**/*.md
!frontend/**/*.md

# Config local
.env
.env.*
!.env.example
docker-compose.yml

# Logs y temporales
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
tmp
temp

# Uploads (datos runtime, no de build)
uploads
data
