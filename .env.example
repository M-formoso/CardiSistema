# ============================================================
# Sistema Cardi — variables de entorno
# Copiar a .env (local) o configurar en Railway (staging/prod)
# ============================================================

# ------- Base de datos -------
# Local con Docker: usa docker-compose.yml
DATABASE_URL="postgresql://cardi:cardi_dev@localhost:5432/cardi?schema=public"

# ------- Backend -------
NODE_ENV="development"
PORT=3000
TZ="America/Argentina/Cordoba"
LOG_LEVEL="info"

# JWT — generar secret con: openssl rand -base64 48
JWT_SECRET="cambiar-en-produccion-usar-openssl-rand-base64-48"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS (separar con coma múltiples orígenes)
CORS_ORIGIN="http://localhost:5173"

# Admin seed inicial (solo se usa en `pnpm db:seed`)
ADMIN_EMAIL="admin@cardi.local"
ADMIN_PASSWORD="cambiar-despues-del-primer-login"
ADMIN_NOMBRE="Administrador Cardi"

# Uploads (comprobantes, cheques, certificaciones)
# Local: ./uploads · Railway: /data/uploads (Volume montado)
UPLOADS_DIR="./uploads"
UPLOADS_MAX_MB=15

# ------- Cotización del dólar -------
# Fuente primaria: dolarapi.com (blue del día)
# Respaldo: Ámbito
# Histórico (para migración 2026): argentinadatos.com
DOLARAPI_URL="https://dolarapi.com/v1/dolares/blue"
AMBITO_URL="https://mercados.ambito.com/dolar/informal/variacion"
ARGENTINADATOS_HISTORICO_URL="https://api.argentinadatos.com/v1/cotizaciones/dolares/blue"

# Tipo de cotización por defecto (BLUE_COMPRA | BLUE_VENTA)
COTIZACION_TIPO_DEFAULT="BLUE_VENTA"

# ------- Frontend (Vite) -------
# El frontend usa variables con prefijo VITE_
VITE_API_URL="http://localhost:3000/api/v1"
VITE_APP_NAME="Cardi"
