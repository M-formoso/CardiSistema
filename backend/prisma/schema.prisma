// Prisma schema del Sistema Cardi
// Convenciones:
// - camelCase (sin @@map), enums en MAYUSCULAS
// - id uuid, createdAt/updatedAt en toda tabla salvo logs
// - createdById/updatedById en toda entidad editable + AuditLog con diff
// - Dinero: Decimal(14,2), cotización: Decimal(14,4), porcentajes: Decimal(7,4)
// - Fechas contables: Date; timestamps: DateTime (TZ America/Argentina/Cordoba)
// - Nunca borrar físicamente: maestros `activo: boolean`, movimientos → reversa

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// ENUMS
// =============================================================

enum RolUsuario {
  ADMIN
  CARGA
  CONSULTA
}

enum Moneda {
  ARS
  USD
}

enum TipoObra {
  OBRA
  UNIDAD_NEGOCIO
  GENERAL
}

enum EstadoObra {
  EN_LICITACION
  ACTIVA
  PAUSADA
  TERMINADA
}

enum TipoBeneficiario {
  EMPLEADO
  CONTRATISTA
  PROVEEDOR
  PROFESIONAL
  OTRO
}

enum TipoCaja {
  EFECTIVO
  BANCO
  CHEQUES_TERCEROS
  OTRO
}

enum TipoMovimiento {
  INGRESO
  EGRESO
  TRANSFERENCIA
  CAMBIO_MONEDA
  AJUSTE
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE_PROPIO
  CHEQUE_TERCERO
}

enum EstadoMovimiento {
  CONFIRMADO
  ANULADO
  REVERSA
}

enum OrigenMovimiento {
  MANUAL
  LIQUIDACION
  CERTIFICACION
  CUOTA
  COMPROMISO
  MIGRACION
  PRESTAMO
  AJUSTE
}

enum SituacionFiscal {
  BLANCO
  NEGRO
}

enum EstadoPrestamoEmpleado {
  VIGENTE
  SALDADO
  ANULADO
}

/// Tipos de concepto que pueden aparecer en un recibo (LiquidacionItem).
/// Cada tipo tiene un signo lógico definido (sumar o restar al subtotal);
/// NOTA_SALDO es informativo y no afecta el total.
enum TipoConceptoLiquidacion {
  JORNAL
  JORNAL_ESPECIAL
  HORAS_EXTRA
  VIATICO
  VACACIONES
  CERTIFICACION
  SUELDO
  PRESTAMO_ENTREGADO
  PRESTAMO_APLICACION
  DEDUCCION
  VALE
  NOTA_SALDO
}

enum CotizacionTipoBlue {
  BLUE
  OFICIAL
}

enum CotizacionTipo {
  BLUE_COMPRA
  BLUE_VENTA
  OFICIAL_COMPRA
  OFICIAL_VENTA
  MANUAL
  PLANILLA
}

enum FuenteCotizacion {
  DOLARAPI
  AMBITO
  ARGENTINADATOS
  MANUAL
}

enum TipoCheque {
  PROPIO
  TERCERO
}

enum EstadoCheque {
  EN_CARTERA
  ENTREGADO
  DEPOSITADO
  COBRADO
  EMITIDO
  DEBITADO
  RECHAZADO
  ANULADO
}

enum EstadoLiquidacion {
  BORRADOR
  APROBADA
  PAGADA_PARCIAL
  PAGADA
  CERRADA
}

enum EstadoCertificacion {
  PENDIENTE
  PARCIAL
  PAGADA
  ANULADA
}

enum EstadoCuota {
  PENDIENTE
  PAGADA
  ANULADA
}

enum EstadoCompromiso {
  PENDIENTE
  PAGADO
  OMITIDO
}

enum EstadoMigracionLote {
  IMPORTANDO
  IMPORTADO
  OBSERVADO
  CANCELADO
}

enum EstadoMigracionFila {
  PENDIENTE
  MAPEADA
  OBSERVADA
  DUPLICADA
  IMPORTADA
  DESCARTADA
}

enum AuditAccion {
  CREAR
  ACTUALIZAR
  ANULAR
  REVERTIR
  EXPORTAR
  LOGIN
  LOGOUT
  OTRO
}

// =============================================================
// BASE
// =============================================================

model Usuario {
  id           String     @id @default(uuid())
  username     String     @unique
  nombre       String
  email        String?
  passwordHash String
  rol          RolUsuario
  activo       Boolean    @default(true)

  permisos      UsuarioPermiso[]
  refreshTokens RefreshToken[]

  // Auditoría de modificaciones hechas por este usuario
  auditLogs AuditLog[] @relation("AuditLogUsuario")

  // Trazabilidad en todos los modelos editables
  obrasCreadas                Obra[]                    @relation("ObraCreadaPor")
  obrasActualizadas           Obra[]                    @relation("ObraActualizadaPor")
  beneficiariosCreados        Beneficiario[]            @relation("BeneficiarioCreadoPor")
  beneficiariosActualizados   Beneficiario[]            @relation("BeneficiarioActualizadoPor")
  categoriasCreadas           CategoriaGasto[]          @relation("CategoriaCreadaPor")
  categoriasActualizadas      CategoriaGasto[]          @relation("CategoriaActualizadaPor")
  cajasCreadas                Caja[]                    @relation("CajaCreadaPor")
  cajasActualizadas           Caja[]                    @relation("CajaActualizadaPor")
  movimientosCreados          Movimiento[]              @relation("MovCreadoPor")
  movimientosActualizados     Movimiento[]              @relation("MovActualizadoPor")
  movimientosAnulados         Movimiento[]              @relation("MovAnuladoPor")
  chequesCreados              Cheque[]                  @relation("ChequeCreadoPor")
  chequesActualizados         Cheque[]                  @relation("ChequeActualizadoPor")
  liquidacionesCreadas        LiquidacionSemanal[]      @relation("LiqCreadaPor")
  liquidacionesActualizadas   LiquidacionSemanal[]      @relation("LiqActualizadaPor")
  liquidacionesCerradas       LiquidacionSemanal[]      @relation("LiqCerradaPor")
  liqPagosCreados             LiquidacionPago[]         @relation("LiqPagoCreadoPor")
  empresasCreadas             Empresa[]                 @relation("EmpresaCreadaPor")
  empresasActualizadas        Empresa[]                 @relation("EmpresaActualizadaPor")
  jornalHistoricosCreados     EmpleadoJornalHistorico[] @relation("JornalHistCreadoPor")
  catEmpleadoCreadas          CategoriaEmpleado[]         @relation("CatEmpleadoCreadaPor")
  catEmpleadoActualizadas     CategoriaEmpleado[]         @relation("CatEmpleadoActualizadaPor")
  catEmpleadoHistoricosCreados CategoriaEmpleadoHistorico[] @relation("CatEmpleadoHistCreadoPor")
  prestamosCreados            PrestamoEmpleado[]        @relation("PrestamoCreadoPor")
  prestamosActualizados       PrestamoEmpleado[]        @relation("PrestamoActualizadoPor")
  certificacionesCreadas      Certificacion[]           @relation("CertCreadaPor")
  certificacionesActualizadas Certificacion[]           @relation("CertActualizadaPor")
  recibosGenerados            Recibo[]                  @relation("ReciboGeneradoPor")
  migracionLotesCreados       MigracionLote[]           @relation("LoteCreadoPor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

/// Permisos granulares por usuario (ej. "empleados.datos_sensibles").
/// Complementa el rol base. El rol otorga el set por defecto;
/// esta tabla agrega excepciones explícitas.
model UsuarioPermiso {
  id        String  @id @default(uuid())
  usuarioId String
  recurso   String // ej. "empleados"
  accion    String // ej. "datos_sensibles", "anular", "export"
  concedido Boolean @default(true)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([usuarioId, recurso, accion])
  @@index([usuarioId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  usuarioId String
  tokenHash String   @unique
  expiresAt DateTime
  revocado  Boolean  @default(false)
  ip        String?
  userAgent String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([expiresAt])
}

model AuditLog {
  id          String      @id @default(uuid())
  usuarioId   String?
  accion      AuditAccion
  entidad     String // ej. "Movimiento"
  entidadId   String?
  antes       Json?
  despues     Json?
  ip          String?
  userAgent   String?
  observacion String?

  usuario Usuario? @relation("AuditLogUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([usuarioId, createdAt])
  @@index([accion, createdAt])
}

model ConfiguracionEmpresa {
  id             String  @id @default(uuid())
  razonSocial    String
  nombreFantasia String? // "Cardi"
  cuit           String
  domicilio      String?
  localidad      String?
  provincia      String?
  telefono       String?
  email          String?
  logoPath       String?

  // Default de cotización para movimientos
  cotizacionTipoDefault CotizacionTipo @default(BLUE_VENTA)
  // Día habitual de pago semanal (0=domingo, ..., 5=viernes, 6=sábado)
  diaPagoSemanal        Int            @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Obra {
  id              String     @id @default(uuid())
  nombre          String     @unique // tal cual lo usa Cardi
  tipo            TipoObra
  comitente       String?
  constructora    String?
  ubicacion       String?
  fechaInicio     DateTime?  @db.Date
  estado          EstadoObra @default(ACTIVA)
  montoContratado Decimal?   @db.Decimal(14, 2)
  monedaContrato  Moneda?
  activo          Boolean    @default(true)

  imputaciones            Imputacion[]
  movimientos             Movimiento[]              @relation("MovimientoObraIngreso")
  liquidaciones           LiquidacionSemanal[]
  liquidacionItemConceptos LiquidacionItemConcepto[]
  certificaciones         Certificacion[]
  contratosCuotas         ContratoCuota[]
  vencimientos            VencimientoRecurrente[]
  compromisos             CompromisoPago[]

  createdById String?
  updatedById String?
  createdBy   Usuario? @relation("ObraCreadaPor", fields: [createdById], references: [id])
  updatedBy   Usuario? @relation("ObraActualizadaPor", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo, estado])
  @@index([activo])
}

/// Tabla única para todos a quienes se paga.
/// 1:1 opcional con `EmpleadoLegajo` si tipo == EMPLEADO.
model Beneficiario {
  id            String           @id @default(uuid())
  tipo          TipoBeneficiario
  nombre        String // nombre o razón social
  cuitCuil      String?
  rubro         String?
  contacto      String?
  condicionPago String?
  observaciones String?
  activo        Boolean          @default(true)

  legajo            EmpleadoLegajo?
  aliases           BeneficiarioAlias[]
  movimientos       Movimiento[]
  cheques           Cheque[]
  liquidItems       LiquidacionItem[]
  certificaciones   Certificacion[]
  contratos         ContratoCuota[]
  vencimientos      VencimientoRecurrente[]
  compromisos       CompromisoPago[]
  recibos           Recibo[]
  vacaciones        Vacacion[]
  prestamosEmpleado PrestamoEmpleado[]

  createdById String?
  updatedById String?
  createdBy   Usuario? @relation("BeneficiarioCreadoPor", fields: [createdById], references: [id])
  updatedBy   Usuario? @relation("BeneficiarioActualizadoPor", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipo])
  @@index([activo])
  @@index([nombre])
}

model EmpleadoLegajo {
  id              String          @id @default(uuid())
  beneficiarioId  String          @unique
  fechaIngreso    DateTime        @db.Date
  dni             String?
  empresaId       String?
  categoriaId     String?
  situacionFiscal SituacionFiscal @default(NEGRO)
  // Jornal / hora extra efectivos del empleado. Si categoriaId está seteado
  // y el empleado no tiene valor propio, estos se heredan de la categoría al
  // crear/actualizar; si tiene valor propio, prevalece el propio.
  jornal          Decimal?        @db.Decimal(14, 2)
  valorHoraExtra  Decimal?        @db.Decimal(14, 2)
  montoSemanal    Decimal?        @db.Decimal(14, 2)
  moneda          Moneda          @default(ARS)
  obraActualId    String?
  observaciones   String?

  beneficiario Beneficiario       @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  empresa      Empresa?           @relation(fields: [empresaId], references: [id])
  categoria    CategoriaEmpleado? @relation(fields: [categoriaId], references: [id])

  historialJornales EmpleadoJornalHistorico[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([categoriaId])
  @@index([obraActualId])
}

/// Categoría laboral del empleado (Oficial Capataz, Oficial, Medio Oficial,
/// Ayudante, etc.). Tiene jornal y valor hora extra "de referencia". Cambiar
/// estos valores propaga a todos los empleados de la categoría y queda
/// registrado en `CategoriaEmpleadoHistorico` + un `EmpleadoJornalHistorico`
/// por empleado afectado.
model CategoriaEmpleado {
  id             String   @id @default(uuid())
  codigo         String   @unique
  nombre         String
  jornal         Decimal? @db.Decimal(14, 2)
  valorHoraExtra Decimal? @db.Decimal(14, 2)
  orden          Int      @default(0)
  activo         Boolean  @default(true)

  empleados EmpleadoLegajo[]
  historial CategoriaEmpleadoHistorico[]

  createdById String?
  updatedById String?
  createdBy   Usuario? @relation("CatEmpleadoCreadaPor", fields: [createdById], references: [id])
  updatedBy   Usuario? @relation("CatEmpleadoActualizadaPor", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

/// Un registro por cada cambio de jornal / valor de hora extra de una categoría.
/// Permite auditar aumentos salariales por categoría.
model CategoriaEmpleadoHistorico {
  id             String   @id @default(uuid())
  categoriaId    String
  jornal         Decimal  @db.Decimal(14, 2)
  valorHoraExtra Decimal? @db.Decimal(14, 2)
  vigenteDesde   DateTime @db.Date
  motivo         String?
  empleadosAfectados Int  @default(0)

  categoria CategoriaEmpleado @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   Usuario? @relation("CatEmpleadoHistCreadoPor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([categoriaId, vigenteDesde])
}

/// Un registro por cada cambio de jornal / valor de hora extra.
/// Al liquidar una semana vieja, se usa el jornal vigente a esa fecha.
/// El valor actual se desnormaliza en `EmpleadoLegajo.jornal` / `.valorHoraExtra`.
model EmpleadoJornalHistorico {
  id             String   @id @default(uuid())
  legajoId       String
  jornal         Decimal  @db.Decimal(14, 2)
  valorHoraExtra Decimal? @db.Decimal(14, 2)
  vigenteDesde   DateTime @db.Date
  motivo         String?

  legajo EmpleadoLegajo @relation(fields: [legajoId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   Usuario? @relation("JornalHistCreadoPor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([legajoId, vigenteDesde])
}

/// Razón social a la que pertenece el empleado (Cardi, Picardi, u otras).
/// Cardi opera con varias, se maneja en una tabla propia.
model Empresa {
  id     String  @id @default(uuid())
  nombre String  @unique
  cuit   String?
  activo Boolean @default(true)

  empleados EmpleadoLegajo[]

  createdById String?
  updatedById String?
  createdBy   Usuario? @relation("EmpresaCreadaPor", fields: [createdById], references: [id])
  updatedBy   Usuario? @relation("EmpresaActualizadaPor", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

/// Préstamo entregado a un empleado. Nace de un egreso en billetera
/// con categoría "Préstamos a empleados"; se descuenta parcial o totalmente
/// en liquidaciones futuras via PrestamoAplicacion.
model PrestamoEmpleado {
  id             String                 @id @default(uuid())
  beneficiarioId String // tipo EMPLEADO
  fecha          DateTime               @db.Date
  monto          Decimal                @db.Decimal(14, 2)
  moneda         Moneda                 @default(ARS)
  saldoPendiente Decimal                @db.Decimal(14, 2)
  estado         EstadoPrestamoEmpleado @default(VIGENTE)
  movimientoId   String? // egreso en billetera que lo originó
  observaciones  String?

  beneficiario Beneficiario @relation(fields: [beneficiarioId], references: [id])
  movimiento   Movimiento?  @relation("PrestamoMovimientoOrigen", fields: [movimientoId], references: [id])

  aplicaciones      PrestamoAplicacion[]
  conceptosReferencia LiquidacionItemConcepto[] @relation("PrestamoConceptoReferencia")

  createdById String?
  updatedById String?
  createdBy   Usuario? @relation("PrestamoCreadoPor", fields: [createdById], references: [id])
  updatedBy   Usuario? @relation("PrestamoActualizadoPor", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([beneficiarioId])
  @@index([estado])
}

/// Aplicación de un préstamo a una liquidación concreta (descuento de X$).
/// SUM(monto) == PrestamoEmpleado.monto como máximo. saldoPendiente se mantiene
/// consistente en el service dentro de una transacción.
model PrestamoAplicacion {
  id                String  @id @default(uuid())
  prestamoId        String
  liquidacionItemId String
  monto             Decimal @db.Decimal(14, 2)

  prestamo        PrestamoEmpleado @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  liquidacionItem LiquidacionItem  @relation(fields: [liquidacionItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([prestamoId])
  @@index([liquidacionItemId])
}

/// Nombres libres y apodos que aparecen en las planillas → beneficiario.
/// Alimenta el autocompletado y la migración desde Excel.
model BeneficiarioAlias {
  id             String @id @default(uuid())
  beneficiarioId String
  alias          String

  beneficiario Beneficiario @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([alias])
  @@index([beneficiarioId])
}

model CategoriaGasto {
  id       String  @id @default(uuid())
  codigo   String  @unique
  nombre   String
  orden    Int     @default(0)
  activo   Boolean @default(true)
  parentId String? // si en el futuro se decide usar subcategorías

  parent        CategoriaGasto?  @relation("Subcategoria", fields: [parentId], references: [id])
  subcategorias CategoriaGasto[] @relation("Subcategoria")

  movimientos  Movimiento[]
  vencimientos VencimientoRecurrente[]
  aliases      ConceptoAlias[]

  createdById String?
  updatedById String?
  createdBy   Usuario? @relation("CategoriaCreadaPor", fields: [createdById], references: [id])
  updatedBy   Usuario? @relation("CategoriaActualizadaPor", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

/// Diccionario texto-origen → categoría (ej. nombre de fletero → "Fletes").
/// Alimenta la migración y el autocompletado.
model ConceptoAlias {
  id          String @id @default(uuid())
  texto       String @unique
  categoriaId String

  categoria CategoriaGasto @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([categoriaId])
}

// =============================================================
// BILLETERA
// =============================================================

model Caja {
  id                String   @id @default(uuid())
  nombre            String   @unique
  tipo              TipoCaja
  moneda            Moneda
  saldoInicial      Decimal  @default(0) @db.Decimal(14, 2)
  fechaSaldoInicial DateTime @db.Date
  activo            Boolean  @default(true)

  movimientos      Movimiento[]
  pagosLiquidacion LiquidacionPago[]

  createdById String?
  updatedById String?
  createdBy   Usuario? @relation("CajaCreadaPor", fields: [createdById], references: [id])
  updatedBy   Usuario? @relation("CajaActualizadaPor", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
  @@index([tipo])
}

/// Snapshot diario de la cotización por tipo y fuente.
/// El cron de cotizaciones hace upsert idempotente por (fecha, tipo, fuente).
model CotizacionDolar {
  id     String             @id @default(uuid())
  fecha  DateTime           @db.Date
  tipo   CotizacionTipoBlue
  compra Decimal            @db.Decimal(14, 4)
  venta  Decimal            @db.Decimal(14, 4)
  fuente FuenteCotizacion

  createdAt DateTime @default(now())

  @@unique([fecha, tipo, fuente])
  @@index([fecha])
}

/// Libro único de la billetera.
/// INGRESO/EGRESO afectan la caja indicada.
/// TRANSFERENCIA y CAMBIO_MONEDA van en PAR (misma grupoId, dos filas).
model Movimiento {
  id          String         @id @default(uuid())
  tipo        TipoMovimiento
  fecha       DateTime       @db.Date
  cajaId      String
  moneda      Moneda // congelada = moneda de la caja
  monto       Decimal        @db.Decimal(14, 2) // siempre positivo; el signo lo da el tipo
  medioPago   MedioPago
  descripcion String?

  // Cotización usada para calcular el equivalente en la otra moneda.
  cotizacion     Decimal        @db.Decimal(14, 4) // ARS por 1 USD
  cotizacionTipo CotizacionTipo
  // Equivalentes congelados al momento del registro.
  montoArs       Decimal        @db.Decimal(14, 2)
  montoUsd       Decimal        @db.Decimal(14, 2)

  beneficiarioId String?
  categoriaId    String?

  // Para INGRESO: obra opcional (etapa 2 lo profundiza).
  obraIngresoId String?

  // Vínculos opcionales con cheque y recibo
  chequeId String?
  reciboId String?

  // Agrupa las dos patas de una transferencia/cambio, o los egresos de una liquidación/certificación.
  grupoId String?

  // Origen (manual o generado por otro módulo) + id de origen
  origen   OrigenMovimiento @default(MANUAL)
  origenId String?

  // Estado + anulación por reversa
  estado               EstadoMovimiento @default(CONFIRMADO)
  anuladoAt            DateTime?
  anuladoPorId         String?
  motivoAnulacion      String?
  movimientoOriginalId String? // apunta al original cuando este es la REVERSA

  // Para la migración 2026: fila de origen en las planillas
  migracionFilaId String?

  // Relaciones
  caja               Caja            @relation(fields: [cajaId], references: [id])
  beneficiario       Beneficiario?   @relation(fields: [beneficiarioId], references: [id])
  categoria          CategoriaGasto? @relation(fields: [categoriaId], references: [id])
  obraIngreso        Obra?           @relation("MovimientoObraIngreso", fields: [obraIngresoId], references: [id])
  cheque             Cheque?         @relation(fields: [chequeId], references: [id])
  recibo             Recibo?         @relation(fields: [reciboId], references: [id])
  movimientoOriginal Movimiento?     @relation("MovimientoReversa", fields: [movimientoOriginalId], references: [id])
  reversas           Movimiento[]    @relation("MovimientoReversa")
  migracionFila      MigracionFila?  @relation(fields: [migracionFilaId], references: [id])

  prestamosOriginados PrestamoEmpleado[] @relation("PrestamoMovimientoOrigen")
  pagoLiquidacion     LiquidacionPago?

  imputaciones Imputacion[]

  // Auditoría
  createdById String?
  updatedById String?
  createdBy   Usuario? @relation("MovCreadoPor", fields: [createdById], references: [id])
  updatedBy   Usuario? @relation("MovActualizadoPor", fields: [updatedById], references: [id])
  anuladoPor  Usuario? @relation("MovAnuladoPor", fields: [anuladoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([cajaId, fecha])
  @@index([estado])
  @@index([tipo, estado])
  @@index([beneficiarioId])
  @@index([categoriaId])
  @@index([grupoId])
  @@index([origen, origenId])
}

/// Un movimiento puede imputarse a 1..N obras.
/// SUM(monto) == Movimiento.monto (validado en service + packages/shared).
model Imputacion {
  id           String  @id @default(uuid())
  movimientoId String
  obraId       String
  monto        Decimal @db.Decimal(14, 2)
  porcentaje   Decimal @db.Decimal(7, 4)

  movimiento Movimiento @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  obra       Obra       @relation(fields: [obraId], references: [id])

  createdAt DateTime @default(now())

  @@unique([movimientoId, obraId])
  @@index([obraId])
}

model Cheque {
  id             String       @id @default(uuid())
  tipo           TipoCheque
  numero         String
  banco          String?
  sucursal       String?
  librador       String? // para cheques de tercero
  titular        String? // alternativa a librador
  cuit           String?
  monto          Decimal      @db.Decimal(14, 2)
  moneda         Moneda       @default(ARS)
  fechaEmision   DateTime     @db.Date
  fechaPago      DateTime     @db.Date
  estado         EstadoCheque @default(EN_CARTERA)
  beneficiarioId String?
  observaciones  String?
  // Fotos / imágenes del cheque
  imagenesPaths  String[]     @default([])

  beneficiario Beneficiario? @relation(fields: [beneficiarioId], references: [id])
  movimientos  Movimiento[]

  createdById String?
  updatedById String?
  createdBy   Usuario? @relation("ChequeCreadoPor", fields: [createdById], references: [id])
  updatedBy   Usuario? @relation("ChequeActualizadoPor", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipo, numero, banco]) // mismo nro puede repetirse entre bancos
  @@index([estado])
  @@index([fechaPago])
  @@index([beneficiarioId])
}

// =============================================================
// PERSONAS Y COMPROMISOS
// =============================================================

/// Liquidación semanal de UNA obra. Un empleado puede aparecer en varias
/// liquidaciones de la misma semana (una por obra). No hay unique.
model LiquidacionSemanal {
  id              String            @id @default(uuid())
  semanaInicio    DateTime          @db.Date
  semanaFin       DateTime          @db.Date
  obraId          String
  estado          EstadoLiquidacion @default(BORRADOR)
  totalBruto      Decimal           @default(0) @db.Decimal(14, 2)
  totalDescuentos Decimal           @default(0) @db.Decimal(14, 2)
  totalAPagar     Decimal           @default(0) @db.Decimal(14, 2)
  totalPagado     Decimal           @default(0) @db.Decimal(14, 2)
  observaciones   String?

  obra  Obra              @relation(fields: [obraId], references: [id])
  items LiquidacionItem[]
  pagos LiquidacionPago[]

  cerradaAt    DateTime?
  cerradaPorId String?

  createdById String?
  updatedById String?
  createdBy   Usuario? @relation("LiqCreadaPor", fields: [createdById], references: [id])
  updatedBy   Usuario? @relation("LiqActualizadaPor", fields: [updatedById], references: [id])
  cerradaPor  Usuario? @relation("LiqCerradaPor", fields: [cerradaPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([obraId, semanaInicio])
  @@index([semanaInicio, semanaFin])
}

/// Un recibo dentro de una liquidación semanal (una persona).
/// Los montos (subtotal, aPagar) se derivan de los conceptos asociados:
///   subtotal = Σ monto de conceptos con signo aplicado según tipo
///   aPagar   = subtotal (los descuentos/aplicaciones son conceptos negativos)
/// El service recalcula ambos en cada upsert dentro de una transacción.
model LiquidacionItem {
  id             String    @id @default(uuid())
  liquidacionId  String
  beneficiarioId String? // null si solo matcheamos por nombreLibre durante la migración
  nombreLibre    String // nombre tal como aparece en la planilla original
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  aPagar         Decimal   @default(0) @db.Decimal(14, 2)
  pagado         Boolean   @default(false)
  fechaPago      DateTime? @db.Date
  observaciones  String?

  liquidacion  LiquidacionSemanal @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  beneficiario Beneficiario?      @relation(fields: [beneficiarioId], references: [id])

  conceptos            LiquidacionItemConcepto[]
  aplicacionesPrestamo PrestamoAplicacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([liquidacionId])
  @@index([beneficiarioId])
}

/// Línea de un recibo. Cada ítem del recibo real (día × jornal, hs extra,
/// viático, vacaciones, certificación por obra distinta, préstamo entregado,
/// aplicación de préstamo, deducción, nota informativa) es un concepto.
/// El `monto` ya viene con signo según el tipo: positivo para los que suman
/// (JORNAL, HS extra, viático, vacaciones, certificación, sueldo, préstamo
/// entregado), negativo para los que restan (deducción, aplicación préstamo,
/// vale), 0 para NOTA_SALDO (solo informativo).
model LiquidacionItemConcepto {
  id             String                  @id @default(uuid())
  liquidacionItemId String
  tipo           TipoConceptoLiquidacion
  descripcion    String
  cantidad       Decimal?                @db.Decimal(10, 3) // días, horas, unidades
  valorUnitario  Decimal?                @db.Decimal(14, 2)
  monto          Decimal                 @db.Decimal(14, 2) // signado; computado al guardar
  /// Obra a la que se imputa el concepto en el costo por obra. Si null, usa
  /// la obra de la liquidación. Soporta certificaciones imputadas a otras obras.
  obraId         String?
  /// Para PRESTAMO_APLICACION: préstamo existente del que se descuenta.
  /// Para PRESTAMO_ENTREGADO: préstamo nuevo que nace de este concepto (lo
  /// setea el service al confirmar).
  prestamoId     String?
  orden          Int                     @default(0)

  liquidacionItem LiquidacionItem   @relation(fields: [liquidacionItemId], references: [id], onDelete: Cascade)
  obra            Obra?             @relation(fields: [obraId], references: [id])
  prestamo        PrestamoEmpleado? @relation("PrestamoConceptoReferencia", fields: [prestamoId], references: [id])

  createdAt DateTime @default(now())

  @@index([liquidacionItemId, orden])
  @@index([obraId])
  @@index([prestamoId])
  @@index([tipo])
}

/// Pago parcial o total de una liquidación. Cada pago genera un Movimiento.
model LiquidacionPago {
  id            String    @id @default(uuid())
  liquidacionId String
  movimientoId  String?   @unique
  monto         Decimal   @db.Decimal(14, 2)
  fecha         DateTime  @db.Date
  medioPago     MedioPago
  cajaId        String
  observaciones String?

  liquidacion LiquidacionSemanal @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  movimiento  Movimiento?        @relation(fields: [movimientoId], references: [id])
  caja        Caja               @relation(fields: [cajaId], references: [id])

  createdById String?
  createdBy   Usuario? @relation("LiqPagoCreadoPor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([liquidacionId])
  @@index([cajaId, fecha])
}

model Vacacion {
  id             String    @id @default(uuid())
  beneficiarioId String
  desde          DateTime  @db.Date
  hasta          DateTime  @db.Date
  dias           Int
  fechaPago      DateTime? @db.Date
  movimientoId   String?

  beneficiario Beneficiario @relation(fields: [beneficiarioId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([beneficiarioId])
}

model Certificacion {
  id               String              @id @default(uuid())
  beneficiarioId   String // contratista
  obraId           String
  numero           String? // número correlativo si el contratista lo usa
  fecha            DateTime            @db.Date
  descripcion      String?
  monto            Decimal             @db.Decimal(14, 2)
  moneda           Moneda
  porcentajeAvance Decimal?            @db.Decimal(7, 4)
  adjuntoPath      String?
  estado           EstadoCertificacion @default(PENDIENTE)
  saldoPendiente   Decimal             @db.Decimal(14, 2)

  beneficiario Beneficiario @relation(fields: [beneficiarioId], references: [id])
  obra         Obra         @relation(fields: [obraId], references: [id])

  createdById String?
  updatedById String?
  createdBy   Usuario? @relation("CertCreadaPor", fields: [createdById], references: [id])
  updatedBy   Usuario? @relation("CertActualizadaPor", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([obraId])
  @@index([beneficiarioId])
  @@index([estado])
}

model ContratoCuota {
  id             String  @id @default(uuid())
  beneficiarioId String // profesional
  obraId         String?
  concepto       String
  montoTotal     Decimal @db.Decimal(14, 2)
  moneda         Moneda
  cantidadCuotas Int
  observaciones  String?
  activo         Boolean @default(true)

  beneficiario Beneficiario @relation(fields: [beneficiarioId], references: [id])
  obra         Obra?        @relation(fields: [obraId], references: [id])

  cuotas Cuota[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([beneficiarioId])
  @@index([obraId])
}

model Cuota {
  id           String      @id @default(uuid())
  contratoId   String
  numero       Int
  monto        Decimal     @db.Decimal(14, 2)
  vencimiento  DateTime    @db.Date
  estado       EstadoCuota @default(PENDIENTE)
  movimientoId String?

  contrato ContratoCuota @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contratoId, numero])
  @@index([estado])
  @@index([vencimiento])
}

model VencimientoRecurrente {
  id             String  @id @default(uuid())
  concepto       String
  obraId         String?
  categoriaId    String?
  beneficiarioId String?
  diaDelMes      Int
  montoEstimado  Decimal @db.Decimal(14, 2)
  moneda         Moneda  @default(ARS)
  cajaHabitualId String?
  activo         Boolean @default(true)

  obra         Obra?           @relation(fields: [obraId], references: [id])
  categoria    CategoriaGasto? @relation(fields: [categoriaId], references: [id])
  beneficiario Beneficiario?   @relation(fields: [beneficiarioId], references: [id])

  compromisos CompromisoPago[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

model CompromisoPago {
  id             String           @id @default(uuid())
  vencimientoId  String?
  fecha          DateTime         @db.Date
  concepto       String
  obraId         String?
  beneficiarioId String?
  montoEstimado  Decimal          @db.Decimal(14, 2)
  moneda         Moneda           @default(ARS)
  estado         EstadoCompromiso @default(PENDIENTE)
  movimientoId   String?

  vencimiento  VencimientoRecurrente? @relation(fields: [vencimientoId], references: [id])
  obra         Obra?                  @relation(fields: [obraId], references: [id])
  beneficiario Beneficiario?          @relation(fields: [beneficiarioId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([estado])
}

model Recibo {
  id             String   @id @default(uuid())
  numero         Int      @unique @default(autoincrement())
  fecha          DateTime @db.Date
  beneficiarioId String?
  monto          Decimal  @db.Decimal(14, 2)
  moneda         Moneda
  concepto       String
  pdfPath        String?
  generadoPorId  String?

  beneficiario Beneficiario? @relation(fields: [beneficiarioId], references: [id])
  generadoPor  Usuario?      @relation("ReciboGeneradoPor", fields: [generadoPorId], references: [id])

  movimientos Movimiento[]

  createdAt DateTime @default(now())

  @@index([fecha])
  @@index([beneficiarioId])
}

// =============================================================
// MIGRACIÓN 2026
// =============================================================

model MigracionLote {
  id          String              @id @default(uuid())
  archivo     String
  hoja        String?
  descripcion String?
  estado      EstadoMigracionLote @default(IMPORTANDO)

  filas MigracionFila[]

  createdById String?
  createdBy   Usuario? @relation("LoteCreadoPor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
}

model MigracionFila {
  id          String              @id @default(uuid())
  loteId      String
  fila        Int // número de fila original en el Excel
  datos       Json // dato crudo tal cual venía
  estado      EstadoMigracionFila @default(PENDIENTE)
  observacion String?

  lote        MigracionLote @relation(fields: [loteId], references: [id], onDelete: Cascade)
  movimientos Movimiento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loteId, fila])
  @@index([estado])
}
