// Prisma schema del Sistema Cardi
// El contenido completo de modelos se genera en el paso 7 (schema.prisma inicial),
// que se revisa con Mateo antes de aplicarse. Este archivo queda inicializado
// con el datasource y generator para que `prisma generate` no falle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
